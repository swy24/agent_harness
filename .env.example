# Copy to .env and adjust. Everything has a working local default.

# Self-hosted model (Ollama) for routine reasoning
LOCAL_MODEL=ollama_chat/qwen2.5:latest

# "Complex reasoning" model (insights agent). Defaults to LOCAL_MODEL.
# Third-party example (needs the API key below):  COMPLEX_MODEL=anthropic/claude-sonnet-5-5
# Bigger local example (needs ~32 GB RAM):       COMPLEX_MODEL=ollama_chat/qwen3.6:latest
# COMPLEX_MODEL=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# LLM-as-judge for the eval suite. Ideally stronger than the model under test.
# JUDGE_MODEL=

OLLAMA_API_BASE=http://localhost:11434
JWT_SECRET=change-me-to-a-long-random-string-in-any-shared-env
INTERNAL_API_KEY=change-me
DAILY_LLM_BUDGET_USD=0.50
